{
  "name": "dsh-lorebookmd",
  "version": "1.0.0",
  "description": "DSH lorebook-driven fiction writer plugin: import Tavern/SillyTavern character cards & world books, save local Markdown lore documents, and generate novel prose with the world settings as reference.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "lorebook",
    "world-info",
    "sillytavern",
    "tavern",
    "novel",
    "fiction"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "bundle": "node ./.dsh-tools/tsdown/run.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/"
  },
  "dsh": {
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
